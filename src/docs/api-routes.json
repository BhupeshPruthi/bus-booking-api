{
  "title": "Bus Booking API route manifest",
  "baseUrl": "/api",
  "notes": "Trimmed to match MyBus Android (ApiService.kt) + shared auth. Run npm run api:list to print this list.",
  "consistencyAudit": {
    "lastReviewed": "2026-07-26",
    "validators": {
      "joiDescribeKeysMisuse": false,
      "paginationMergedWith": "Joi.concat(paginationSchema) for searchBusesSchema and bookingQuerySchema"
    },
    "controllers": {
      "successResponses": "auth, admin, and consumer handlers use { success: true, data } for 200/201"
    }
  },
  "nonApi": [
    { "method": "GET", "path": "/health", "auth": "none", "description": "Liveness" },
    { "method": "GET", "path": "/uploads/*", "auth": "none", "description": "Static uploaded files" }
  ],
  "routes": [
    { "method": "POST", "path": "/api/auth/google", "auth": "none", "group": "auth" },
    { "method": "POST", "path": "/api/auth/refresh-token", "auth": "none", "group": "auth" },
    { "method": "POST", "path": "/api/auth/logout", "auth": "none", "group": "auth" },
    { "method": "GET", "path": "/api/auth/session", "auth": "bearer", "group": "auth" },
    { "method": "GET", "path": "/api/buses", "auth": "none", "group": "consumer" },
    { "method": "GET", "path": "/api/buses/:id", "auth": "none", "group": "consumer" },
    { "method": "GET", "path": "/api/poojas", "auth": "none", "group": "consumer" },
    { "method": "GET", "path": "/api/poojas/bookings", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/poojas/:id", "auth": "none", "group": "consumer" },
    { "method": "GET", "path": "/api/events", "auth": "none", "group": "consumer" },
    { "method": "GET", "path": "/api/events/images/:imageName", "auth": "none", "group": "consumer" },
    { "method": "POST", "path": "/api/bookings", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/bookings", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/me/bookings", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/me/bookings/:bookingType/:bookingId", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/bookings/:id", "auth": "bearer", "group": "consumer" },
    { "method": "POST", "path": "/api/bookings/:id/cancellation-request", "auth": "bearer", "group": "consumer" },
    { "method": "POST", "path": "/api/poojas/:id/bookings", "auth": "bearer", "group": "consumer" },
    { "method": "GET", "path": "/api/stays/catalog", "auth": "none", "group": "stay" },
    { "method": "POST", "path": "/api/stays/quote", "auth": "none", "group": "stay" },
    { "method": "POST", "path": "/api/stays/bookings", "auth": "bearer", "group": "stay" },
    { "method": "GET", "path": "/api/stays/bookings", "auth": "bearer", "group": "stay" },
    { "method": "GET", "path": "/api/stays/bookings/:id", "auth": "bearer", "group": "stay" },
    { "method": "POST", "path": "/api/stays/bookings/:id/cancellation-requests", "auth": "bearer", "group": "stay" },
    { "method": "POST", "path": "/api/admin/events", "auth": "bearer+busAdmin", "group": "admin", "body": "JSON or multipart/form-data with optional image" },
    { "method": "POST", "path": "/api/admin/trips", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "POST", "path": "/api/admin/poojas", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "PUT", "path": "/api/admin/poojas/:id", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "DELETE", "path": "/api/admin/poojas/:id", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "GET", "path": "/api/admin/poojas", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "GET", "path": "/api/admin/poojas/:id", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "POST", "path": "/api/admin/poojas/:poojaId/bookings/:bookingId/cancel", "auth": "bearer+poojaAdmin", "group": "admin" },
    { "method": "GET", "path": "/api/admin/buses", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "DELETE", "path": "/api/admin/buses/:id", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "GET", "path": "/api/admin/bookings", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "PUT", "path": "/api/admin/bookings/:id/status", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "POST", "path": "/api/admin/bookings/:id/cancel", "auth": "bearer+busAdmin", "group": "admin" },
    { "method": "GET", "path": "/api/admin/stay/coupons", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/coupons", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/coupons/:id/deactivate", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "GET", "path": "/api/admin/stay/daily-occupancy", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "GET", "path": "/api/admin/stay/daily-occupancy/:date/bookings", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "GET", "path": "/api/admin/stay/bookings", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/bookings", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "GET", "path": "/api/admin/stay/bookings/:id", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/bookings/:id/cancel", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/bookings/:id/confirm", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/bookings/:id/reject", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "GET", "path": "/api/admin/stay/cancellation-requests", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "POST", "path": "/api/admin/stay/cancellation-requests/:id/decision", "auth": "bearer+stayAdmin", "group": "stay-admin" },
    { "method": "PUT", "path": "/api/chalisa/participant", "auth": "bearer|chalisaGuest", "group": "chalisa" },
    { "method": "POST", "path": "/api/chalisa/readings", "auth": "bearer|chalisaGuest", "group": "chalisa" },
    { "method": "DELETE", "path": "/api/chalisa/readings/:clientRequestId", "auth": "bearer|chalisaGuest", "group": "chalisa" },
    { "method": "GET", "path": "/api/chalisa/me", "auth": "bearer|chalisaGuest", "group": "chalisa" },
    { "method": "GET", "path": "/api/chalisa/marathon", "auth": "none", "group": "chalisa" },
    { "method": "GET", "path": "/api/chalisa/summary", "auth": "none", "group": "chalisa" },
    { "method": "GET", "path": "/api/chalisa/marathons/archive", "auth": "none", "group": "chalisa" },
    { "method": "POST", "path": "/api/admin/chalisa/marathons", "auth": "bearer+superAdmin", "group": "chalisa-admin" },
    { "method": "PATCH", "path": "/api/admin/chalisa/marathons/:id", "auth": "bearer+superAdmin", "group": "chalisa-admin" },
    { "method": "DELETE", "path": "/api/admin/chalisa/marathons/:id", "auth": "bearer+superAdmin", "group": "chalisa-admin" },
    { "method": "POST", "path": "/api/admin/chalisa/marathons/:id/end", "auth": "bearer+superAdmin", "group": "chalisa-admin" },
    { "method": "POST", "path": "/api/admin/chalisa/marathons/:id/restore", "auth": "bearer+superAdmin", "group": "chalisa-admin" },
    { "method": "POST", "path": "/api/admin/chalisa/readings", "auth": "bearer+superAdmin", "group": "chalisa-admin" }
  ],
  "myBusAndroidRetrofit": {
    "source": "MyBus/app/src/main/java/com/mybus/app/data/remote/ApiService.kt",
    "pathsRelativeToApi": [
      "help-contacts",
      "auth/google",
